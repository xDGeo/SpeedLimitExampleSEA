@startuml 01_architecture_operational
title SpeedLimit: operational stage, components and allowed-to-use specification
skinparam shadowing false
skinparam componentStyle rectangle
skinparam nodesep 40
skinparam ranksep 70
skinparam defaultFontSize 12
skinparam ArrowColor #444444

[app.py\nStreamlit GUI + Scheduler] as GUI
[core.cycle\nCycleOrchestrator] as Cycle
[core.parameter_ranges\nInputGuardrail + NormalAbnormal] as Ranges
[core.router\nRouter] as Router
[core.features\nFeatureBuilder] as Features
[core.model\nEnsemble Predictor] as Model
[core.weather_policy\nWeatherPolicy + output guardrail] as Weather
[core.air_quality\nAirQualityClient] as Air
[core.llm_manager\nLLMManager: guardrails + gateway] as LLM
[core.decider\nSpeedLimitDecider] as Decider
[core.confidence\nConfidenceRater] as Confidence
cloud "Open-Meteo API" as OpenMeteo
cloud "Local Ollama\nqwen3:8b" as Ollama
database "artifacts/\ndecisions.jsonl\nllm_calls.jsonl" as Art

GUI ..> Cycle : <<use>>
GUI ..> Ranges : <<use>>
Cycle ..> Ranges : <<use>>
Cycle ..> Router : <<use>>
Cycle ..> Features : <<use>>
Cycle ..> Model : <<use>>
Cycle ..> Weather : <<use>>
Cycle ..> Air : <<use>>
Cycle ..> LLM : <<use>>
Cycle ..> Decider : <<use>>
Features ..> Router : <<use>>
Weather ..> Confidence : <<use>>
LLM ..> Confidence : <<use>>
Air ..> OpenMeteo : <<use>>
LLM ..> Ollama : <<use>>
Cycle ..> Art : writes
LLM ..> Art : writes

note bottom of Router
  Every core module may use core.config.
  Those arrows are omitted for readability.
  Only LLMManager may reach the LLM.
end note
@enduml
